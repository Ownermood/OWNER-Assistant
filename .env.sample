# ================================================================
#  OWNER Assistant config  -  copy this file to ".env" and fill it.
#  Don't use quotes ( " or ' ) around values.
# ================================================================

# ----------------- OWNER MANAGER (recommended) -----------------
# A separate control bot: login / logout / restart / logs from your phone,
# no terminal. Make a NEW bot at @BotFather (not the assistant bot) and put
# its token here, plus your own Telegram user id (the bot tells you if empty).
# With these two set, SESSION below is optional: just press Login in the bot.
MANAGER_BOT_TOKEN=
OWNER_ID=
# Channel you must join to use the manager (make the manager bot an ADMIN there
# so it can check). FORCE_JOIN=off to disable.
FORCE_JOIN=@VillanCommunity
FORCE_JOIN_ID=-1004443904846

# ----------------- REQUIRED without the manager -----------------
# Telethon string session of your account.
# Make it with:  bash sessiongen   (never use unknown bots/websites for this)
SESSION=

# From https://my.telegram.org -> API development tools.
# (Optional: if empty, a public default is used, but your own is safer.)
API_ID=
API_HASH=


# ----------------- DATABASE (optional) -----------------
# Leave ALL empty  -> data is saved in a local file (fine for a VPS/PC).
# Docker compose   -> a Redis is started for you automatically.
# Cloud (Heroku, Render, Koyeb...) -> use ONE of these free DBs:
#   Redis:   REDIS_URI=redis://default:password@host:port   (Redis Cloud / Upstash)
#            or REDIS_URI=host:port  together with REDIS_PASSWORD
#   MongoDB: MONGO_URI=mongodb+srv://user:pass@cluster/...
#   Postgres DATABASE_URL=postgresql://user:pass@host:5432/db
REDIS_URI=
REDIS_PASSWORD=
MONGO_URI=
DATABASE_URL=


# ----------------- AUTO-CREATED (optional) -----------------
# Leave empty: the bot makes the assistant bot (via @BotFather) and the
# log group for you on first start.
BOT_TOKEN=
LOG_CHANNEL=


# ----------------- EXTRAS (optional) -----------------
# Extra plugins in the "addons" folder are ON by default. Set False to disable.
ADDONS=True

# Repo used by .update (your fork).
UPSTREAM_REPO=https://github.com/Ownermood/OWNER-Assistant
UPSTREAM_BRANCH=main

# Only for Heroku users (.usage / restart from bot).
HEROKU_API=
HEROKU_APP_NAME=

# More keys (AI, OCR, weather...) are set from Telegram, no restart needed:
#   .setdb GEMINI_API_KEY your_key      -> .gemini and the AI chatbot (free key at aistudio.google.com)
#   .setdb OPENAI_API_KEY / ANTHROPIC_KEY / DEEPSEEK_API_KEY
#   .setdb OCR_API key                  -> .ocr      (free at ocr.space)
#   .setdb OPENWEATHER_API key          -> .weather / .air
#   .setdb RMBG_API key                 -> .rmbg     (remove.bg)
# Full list: see SETUP.md
